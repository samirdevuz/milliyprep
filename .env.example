# --- Auth ---
# Secret used to sign session cookies. Generate a 32+ character unique value.
AUTH_SECRET=

# App URL without trailing slash (used for OAuth redirect URIs)
APP_URL=http://localhost:3000

# --- Database (Supabase Postgres) ---
# Server-only values. Do not prefix these with NEXT_PUBLIC.
# Preferred: Supabase Settings > API Keys > Secret key (sb_secret_...)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback if your Supabase project still shows service_role JWT keys:
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram bot ---
# Shared secret between the website and the bot (must match bot/.env).
# Use a 24+ character random value.
BOT_API_SECRET=

# --- Google OAuth ---
# From Google Cloud Console. Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional, for OTP delivery via Resend) ---
NEXT_PUBLIC_ENABLE_EMAIL_AUTH=true
RESEND_API_KEY=
MAIL_FROM=MilliyPrep <no-reply@milliyprep.uz>

# --- SMS (optional, for OTP delivery via Eskiz) ---
# If unset, phone OTP works only in dev/demo mode.
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false
ESKIZ_TOKEN=
ESKIZ_FROM=4546

# --- AI tutor (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
